(() => {
  const tg = window.Telegram?.WebApp;
  if (tg) { tg.ready(); tg.expand(); tg.setHeaderColor?.('#000000'); tg.setBackgroundColor?.('#000000'); }

  const state = { users: [], user: null, chats: [], chat: null, filter: 'all', nextBefore: null, loadingMore: false, messages: new Map(), editingMessage: null, globalSearchQuery: '', searchResults: [], searchOffset: 0, searchHasMore: false, searchLoading: false };
  const $ = (id) => document.getElementById(id);
  const app = $('app');
  const qs = new URLSearchParams(location.search);
  const isLocal = ['localhost', '127.0.0.1'].includes(location.hostname);
  const initData = tg?.initData || '';
  const devUser = isLocal ? qs.get('devUser') || '' : '';
  let toastTimer;

  function toast(message) {
    const el = $('toast'); el.textContent = message; el.classList.add('show');
    clearTimeout(toastTimer); toastTimer = setTimeout(() => el.classList.remove('show'), 2600);
  }
  async function api(path, options = {}) {
    const headers = { 'X-Telegram-Init-Data': initData, ...(options.headers || {}) };
    if (devUser) headers['X-Holygram-Dev-User'] = devUser;
    const response = await fetch(path, { ...options, headers });
    let body = {}; try { body = await response.json(); } catch (_) {}
    if (!response.ok) throw new Error(body.error || `Ошибка ${response.status}`);
    return body;
  }
  function mediaUrl(url, lottie = false) {
    const separator = url.includes('?') ? '&' : '?';
    const params = [];
    if (lottie) params.push('format=lottie');
    if (devUser) params.push(`devUser=${encodeURIComponent(devUser)}`);
    return params.length ? `${url}${separator}${params.join('&')}` : url;
  }
  function cleanChatName(value) {
    return String(value || 'Диалог')
      .replace(/,?\s*ID:\s*-?\d+/gi, '')
      .replace(/\(\s*,?\s*\)/g, '')
      .replace(/\s{2,}/g, ' ')
      .trim() || 'Диалог';
  }

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
  }
  function initials(name) {
    const parts = String(name || '?').replace(/\s*\([^)]*\)\s*$/, '').replace(/^@/, '').trim().split(/\s+/).filter(Boolean);
    return (parts.slice(0, 2).map(x => x[0]).join('') || '?').toUpperCase();
  }
  function hue(id) { return Math.abs(Number(id || 0)) % 360; }
  function avatarHtml(person, useId = true) {
    const id = useId ? person.id : person.author_id;
    const name = person.name || person.author || '?';
    const src = id ? `/api/avatar/${id}` : '';
    return `<div class="avatar" style="background:hsl(${hue(id)} 32% 31%)">${src ? `<img src="${src}${devUser ? `?devUser=${encodeURIComponent(devUser)}` : ''}" alt="" loading="lazy">` : ''}<span>${escapeHtml(initials(name))}</span></div>`;
  }
  function setAvatar(el, person) {
    el.style.background = `hsl(${hue(person.id)} 32% 31%)`;
    el.innerHTML = `<img src="/api/avatar/${person.id}${devUser ? `?devUser=${encodeURIComponent(devUser)}` : ''}" alt=""><span>${escapeHtml(initials(person.name))}</span>`;
  }
  function formatTime(ts, withDate = false) {
    if (!ts) return '';
    const date = new Date(ts * 1000);
    const today = new Date();
    if (!withDate && date.toDateString() === today.toDateString()) return date.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Moscow' });
    return date.toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Moscow' });
  }
  function formatDay(ts) {
    if (!ts) return '';
    const date = new Date(ts * 1000);
    const now = new Date();
    const moscow = value => value.toLocaleDateString('en-CA', { timeZone: 'Europe/Moscow' });
    if (moscow(date) === moscow(now)) return 'Сегодня';
    const yesterday = new Date(now.getTime() - 86400000);
    if (moscow(date) === moscow(yesterday)) return 'Вчера';
    return date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: date.getFullYear() === now.getFullYear() ? undefined : 'numeric', timeZone: 'Europe/Moscow' });
  }
  function skeleton(count = 6) { return Array.from({length: count}, () => '<div class="skeleton"></div>').join(''); }
  function empty(icon, title, text) { return `<div class="empty-icon">${icon}</div><b>${escapeHtml(title)}</b><span>${escapeHtml(text)}</span>`; }
  function debounce(fn, wait = 250) { let timer; return (...args) => { clearTimeout(timer); timer = setTimeout(() => fn(...args), wait); }; }
  function toggleAccounts(show) {
    $('accountDrawer').classList.toggle('hidden', !show);
    $('accountScrim').classList.toggle('hidden', !show);
    if (show) setTimeout(() => $('userSearch').focus(), 30);
  }

  async function toggleUserPin(id, pinned, button) {
    if (button) button.disabled = true;
    try {
      await api(`/api/users/${id}/pin`, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({pinned})
      });
      const item = state.users.find(user => user.id === id);
      if (item) item.pinned = pinned;
      toast(pinned ? 'Пользователь закреплён' : 'Пользователь откреплён');
      await loadUsers($('userSearch')?.value || '');
    } catch (error) {
      toast(error.message || 'Не удалось изменить закрепление');
    } finally {
      if (button) button.disabled = false;
    }
  }

  async function loadUsers(query = '') {
    $('usersList').className = 'list'; $('usersList').innerHTML = skeleton();
    try {
      const data = await api(`/api/users?q=${encodeURIComponent(query)}&limit=80`);
      state.users = data.items;
      $('usersCount').textContent = data.items.length;
      if (!data.items.length) {
        $('usersList').className = 'list empty-state';
        $('usersList').innerHTML = empty('⌕', 'Ничего не найдено', 'Попробуйте другое имя');
        return;
      }
      $('usersList').innerHTML = data.items.map(user => `
        <div class="list-item user-list-item ${state.user?.id === user.id ? 'active' : ''}" data-user="${user.id}" role="button" tabindex="0">
          ${avatarHtml(user)}
          <span class="list-body"><span class="list-line"><span class="list-title">${escapeHtml(user.name)}</span><span class="list-time">${formatTime(user.updated_at)}</span></span>
          <span class="list-preview"><span>${user.username ? '@' + escapeHtml(user.username) + ' · ' : ''}${user.chat_count} чат.</span><span>${user.message_count} сообщ.</span></span></span>
          <button class="user-pin ${user.pinned ? 'active' : ''}" data-pin-user="${user.id}" data-pinned="${user.pinned ? '1' : '0'}" type="button" aria-label="${user.pinned ? 'Открепить пользователя' : 'Закрепить пользователя'}" title="${user.pinned ? 'Открепить' : 'Закрепить'}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6l-1 5 3 3v2h-4v7l-1 1-1-1v-7H7v-2l3-3-1-5z"/></svg>
          </button>
        </div>`).join('');

      document.querySelectorAll('[data-user]').forEach(row => {
        const open = async () => { await selectUser(Number(row.dataset.user)); toggleAccounts(false); };
        row.addEventListener('click', event => {
          if (event.target.closest('[data-pin-user]')) return;
          open();
        });
        row.addEventListener('keydown', event => {
          if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); open(); }
        });
      });
      document.querySelectorAll('[data-pin-user]').forEach(button => button.addEventListener('click', event => {
        event.stopPropagation();
        const id = Number(button.dataset.pinUser);
        const pinned = button.dataset.pinned !== '1';
        toggleUserPin(id, pinned, button);
      }));
    } catch (error) { showFatal(error.message); }
  }

  async function selectUser(id) {
    state.user = state.users.find(item => item.id === id); state.chat = null;
    if (!state.user) return;
    document.querySelectorAll('[data-user]').forEach(el => el.classList.toggle('active', Number(el.dataset.user) === id));
    $('selectedUserName').textContent = state.user.name;
    $('selectedUserMeta').textContent = `${state.user.username ? '@' + state.user.username + ' · ' : ''}${state.user.chat_count} чат. · ${state.user.message_count} сообщ.`;
    setAvatar($('selectedUserAvatar'), state.user);
    setAvatar($('accountAvatar'), state.user);
    $('chatSearch').disabled = false; $('chatSearch').value = ''; state.globalSearchQuery = ''; state.searchResults = []; state.searchOffset = 0; state.searchHasMore = false;
    app.dataset.view = 'chats';
    await loadChats();
  }

  async function loadChats(query = '') {
    if (!state.user) return;
    $('chatsList').className = 'list'; $('chatsList').innerHTML = skeleton();
    try {
      const data = await api(`/api/users/${state.user.id}/chats?q=${encodeURIComponent(query)}`);
      state.chats = data.items;
      renderChats(query);
    } catch (error) { $('chatsList').className = 'list empty-state'; $('chatsList').innerHTML = empty('!', 'Не удалось открыть чаты', error.message); }
  }

  async function searchAllMessages(query, append = false) {
    const normalized = String(query || '').trim();
    state.globalSearchQuery = normalized;

    if (!normalized) {
      state.searchResults = [];
      state.searchOffset = 0;
      state.searchHasMore = false;
      await loadChats();
      return;
    }
    const requestedQuery = normalized;
    const offset = append ? state.searchOffset : 0;
    if (!append) {
      state.searchResults = [];
      state.searchOffset = 0;
      $('chatsList').className = 'list';
      $('chatsList').innerHTML = skeleton(4);
    }

    state.searchLoading = true;
    try {
      const data = await api(`/api/messages/search?q=${encodeURIComponent(requestedQuery)}&limit=80&offset=${offset}`);
      if (state.globalSearchQuery !== requestedQuery) return;
      state.searchResults = append ? state.searchResults.concat(data.items || []) : (data.items || []);
      state.searchOffset = state.searchResults.length;
      state.searchHasMore = Boolean(data.has_more);
      renderGlobalSearchResults(requestedQuery);
    } catch (error) {
      if (state.globalSearchQuery !== requestedQuery) return;
      $('chatsList').className = 'list empty-state';
      $('chatsList').innerHTML = empty('!', 'Не удалось выполнить поиск', error.message);
    } finally {
      state.searchLoading = false;
    }
  }

  function renderGlobalSearchResults(query) {
    const items = state.searchResults;
    if (!items.length) {
      $('chatsList').className = 'list empty-state';
      $('chatsList').innerHTML = empty('⌕', 'Сообщений не найдено', 'Поиск выполнен по чатам всех пользователей');
      return;
    }

    $('chatsList').className = 'list';
    $('chatsList').innerHTML = items.map((item, index) => {
      const preview = item.text || (item.media_type ? `[${item.media_type}]` : 'Сообщение без текста');
      const direction = item.outgoing ? '→' : '←';
      return `
        <button class="list-item global-search-result" data-search-result="${index}" type="button">
          ${avatarHtml({id: item.user.id, name: item.user.name})}
          <span class="list-body">
            <span class="list-line">
              <span class="list-title">${escapeHtml(item.user.name)} · ${escapeHtml(cleanChatName(item.chat_name))}</span>
              <span class="list-time">${formatTime(item.updated_at, true)}</span>
            </span>
            <span class="list-preview">
              <span>${direction} ${escapeHtml(item.author)}: ${escapeHtml(preview)}</span>
              <span>#${item.message_id}</span>
            </span>
          </span>
        </button>`;
    }).join('') + (state.searchHasMore ? '<button id="loadMoreSearch" class="global-search-more" type="button">Показать ещё</button>' : '');

    document.querySelectorAll('[data-search-result]').forEach(button => button.addEventListener('click', () => openGlobalSearchResult(Number(button.dataset.searchResult))));
    $('loadMoreSearch')?.addEventListener('click', () => searchAllMessages(query, true));
  }

  async function openGlobalSearchResult(index) {
    const item = state.searchResults[index];
    if (!item) return;

    try {
      let user = state.users.find(candidate => candidate.id === item.user.id);
      if (!user) {
        const users = await api(`/api/users?q=${encodeURIComponent(String(item.user.id))}&limit=5`);
        user = (users.items || []).find(candidate => candidate.id === item.user.id);
        if (user) state.users.push(user);
      }
      if (!user) {
        user = {
          id: item.user.id,
          name: item.user.name,
          username: item.user.username || '',
          updated_at: item.updated_at,
          chat_count: 0,
          message_count: 0,
          pinned: false
        };
        state.users.push(user);
      }

      await selectUser(user.id);

      let targetChat = state.chats.find(chat => chat.id === item.chat_id);
      if (!targetChat) {
        const data = await api(`/api/users/${user.id}/chats?q=${encodeURIComponent(String(item.chat_id))}`);
        targetChat = (data.items || []).find(chat => chat.id === item.chat_id);
        if (targetChat) {
          state.chats = [targetChat, ...state.chats.filter(chat => chat.id !== targetChat.id)];
          renderChats('');
        }
      }

      if (!targetChat) {
        toast('Чат найденного сообщения недоступен');
        return;
      }

      $('chatSearch').value = '';
      state.globalSearchQuery = '';
      state.searchResults = [];
      await selectChat(item.chat_id, { before: Number(item.updated_at || 0) + 1, focus: item.message_id });
    } catch (error) {
      toast(error.message || 'Не удалось открыть найденное сообщение');
    }
  }

  function renderChats(query = '') {
      const items = state.chats.filter(chat => state.filter === 'all' || (state.filter === 'groups' ? chat.id < 0 : chat.id > 0));
      if (!items.length) { $('chatsList').className = 'list empty-state'; $('chatsList').innerHTML = empty('☰', 'Чатов нет', query ? 'Поиск ничего не нашёл' : 'В этой категории пока пусто'); return; }
      $('chatsList').className = 'list';
      $('chatsList').innerHTML = items.map(chat => `
        <button class="list-item ${state.chat?.id === chat.id ? 'active' : ''}" data-chat="${chat.id}" type="button">
          ${avatarHtml({id: chat.avatar_id, name: cleanChatName(chat.name)})}
          <span class="list-body"><span class="list-line"><span class="list-title">${chat.pinned ? '📌 ' : ''}${escapeHtml(cleanChatName(chat.name))}</span><span class="list-time">${formatTime(chat.updated_at)}</span></span>
          <span class="list-preview"><span>${chat.preview ? escapeHtml(chat.preview) : (chat.media_count ? `Медиа: ${chat.media_count}` : 'Без текста')}</span>${chat.unread ? `<span class="unread">${chat.unread}</span>` : `<span>${chat.message_count}</span>`}</span></span>
        </button>`).join('');
      document.querySelectorAll('[data-chat]').forEach(button => button.addEventListener('click', () => selectChat(Number(button.dataset.chat))));
  }

  async function selectChat(id, options = {}) {
    state.chat = state.chats.find(item => item.id === id);
    if (!state.chat) return;
    document.querySelectorAll('[data-chat]').forEach(el => el.classList.toggle('active', Number(el.dataset.chat) === id));
    $('chatName').textContent = cleanChatName(state.chat.name);
    $('chatMeta').textContent = `${state.chat.message_count} сообщений · ${state.chat.media_count} медиа`;
    setAvatar($('chatAvatar'), {id: state.chat.avatar_id, name: cleanChatName(state.chat.name)});
    $('refreshButton').disabled = false;
    app.dataset.view = 'messages';
    await loadMessages(false, Number(options.before || 0), Number(options.focus || 0));
  }

  function mediaMarkup(media) {
    if (!media) return '';
    const spoiler = media.spoiler ? ' spoiler' : '';
    const url = mediaUrl(media.url);
    const label = media.file_name || ({photo:'photo.jpg',video:'video.mp4',video_note:'circle.mp4',voice:'voice.ogg',audio:'audio.mp3',sticker:'sticker.webp',document:'file'}[media.type] || 'media');
    const sendToBot = ['photo', 'video', 'voice', 'video_note'].includes(media.type);
    const action = sendToBot
      ? `<button class="media-download" type="button" data-send-bot="${escapeHtml(media.url)}" aria-label="Отправить в бот" title="Отправить в бот"><svg viewBox="0 0 24 24"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 20h14"/></svg></button>`
      : `<button class="media-download" type="button" data-download="${escapeHtml(media.url)}" data-name="${escapeHtml(label)}" aria-label="Скачать"><svg viewBox="0 0 24 24"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 20h14"/></svg></button>`;
    if (media.type === 'photo') return `<div class="message-media${spoiler}"><img src="${url}" alt="Фото" loading="lazy">${action}</div>`;
    if (['video','animation'].includes(media.type)) return `<div class="message-media${spoiler}"><video src="${url}" controls playsinline preload="metadata"></video>${action}</div>`;
    if (media.type === 'video_note') return `<div class="message-media"><video class="round${spoiler}" src="${url}" controls playsinline preload="metadata"></video>${action}</div>`;
    if (['voice','audio'].includes(media.type)) return `<div class="message-media"><audio src="${url}" controls preload="metadata"></audio>${action}</div>`;
    if (media.type === 'sticker' && media.animated_sticker) return `<div class="message-media sticker-media"><div class="lottie-sticker" data-lottie="${mediaUrl(media.url, true)}"></div>${action}</div>`;
    if (media.type === 'sticker' && (media.mime_type.includes('webm') || media.file_name.endsWith('.webm'))) return `<div class="message-media sticker-media"><video src="${url}" autoplay loop muted playsinline></video>${action}</div>`;
    if (media.type === 'sticker') return `<div class="message-media sticker-media"><img src="${url}" alt="Стикер" loading="lazy">${action}</div>`;
    return `<button class="file-card media-file-download" type="button" data-download="${escapeHtml(media.url)}" data-name="${escapeHtml(label)}"><span class="file-icon">↓</span><span>${escapeHtml(label)}</span></button>`;
  }

  async function sendMediaToBot(button) {
    if (button.dataset.loading === '1') return;
    const source = button.dataset.sendBot || '';
    const match = source.match(/^\/api\/media\/(\d+)\/(-?\d+)\/(\d+)/);
    if (!match) { toast('Не удалось определить медиа'); return; }
    button.dataset.loading = '1';
    try {
      await api(
        `/api/users/${match[1]}/chats/${match[2]}/messages/${match[3]}/send-to-bot`,
        {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: '{}'
        }
      );
      tg?.HapticFeedback?.notificationOccurred?.('success');
      toast('Отправлено сообщением в бот');
    } catch (error) {
      tg?.HapticFeedback?.notificationOccurred?.('error');
      toast(error.message || 'Не удалось отправить в бот');
    } finally {
      delete button.dataset.loading;
    }
  }

  async function downloadMedia(button) {
    if (button.dataset.loading === '1') return;
    button.dataset.loading = '1';
    try {
      const endpoint = button.dataset.download.replace('/api/media/', '/api/download/').split('?')[0];
      const data = await api(endpoint);
      const fileName = data.file_name || button.dataset.name || 'media';
      if (tg?.downloadFile && (!tg.isVersionAtLeast || tg.isVersionAtLeast('8.0'))) {
        tg.downloadFile({url: data.url, file_name: fileName}, accepted => toast(accepted ? 'Скачивание началось' : 'Скачивание отменено'));
      } else {
        const link = document.createElement('a'); link.href = data.url; link.download = fileName; link.target = '_blank'; link.rel = 'noopener'; document.body.appendChild(link); link.click(); link.remove();
        toast('Скачивание началось');
      }
    } catch (error) { toast(error.message || 'Не удалось скачать файл'); }
    finally { delete button.dataset.loading; }
  }

  function openMessageEditor(messageId) {
    const message = state.messages.get(Number(messageId));
    if (!message || !message.editable || !state.user || !state.chat) return;
    state.editingMessage = message;
    const input = $('editMessageText');
    input.maxLength = Number(message.edit_limit || 4096);
    input.value = message.text || '';
    $('editScrim').classList.remove('hidden');
    $('editSheet').classList.remove('hidden');
    requestAnimationFrame(() => { input.focus(); input.setSelectionRange(input.value.length, input.value.length); });
    tg?.HapticFeedback?.selectionChanged?.();
  }

  function closeMessageEditor() {
    state.editingMessage = null;
    $('editScrim').classList.add('hidden');
    $('editSheet').classList.add('hidden');
    $('editMessageText').value = '';
    $('saveEdit').disabled = false;
  }

  async function saveMessageEdit() {
    const message = state.editingMessage;
    if (!message || !state.user || !state.chat) return;
    const input = $('editMessageText');
    const text = input.value;
    if (!text.trim()) { toast('Сообщение не может быть пустым'); input.focus(); return; }
    if (text.length > Number(message.edit_limit || 4096)) { toast('Сообщение слишком длинное'); return; }
    if (text === message.text) { closeMessageEditor(); return; }

    const button = $('saveEdit');
    button.disabled = true;
    try {
      await api(
        `/api/users/${state.user.id}/chats/${state.chat.id}/messages/${message.id}/edit`,
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text })
        }
      );
      closeMessageEditor();
      tg?.HapticFeedback?.notificationOccurred?.('success');
      toast('Сообщение изменено');
      await loadMessages(false);
      await loadChats($('chatSearch').value);
    } catch (error) {
      button.disabled = false;
      tg?.HapticFeedback?.notificationOccurred?.('error');
      toast(error.message || 'Не удалось изменить сообщение');
    }
  }

  function renderMessages(items, prepend = false) {
    const scroll = $('messageScroll');
    if (!prepend) state.messages.clear();
    items.forEach(message => state.messages.set(Number(message.id), message));
    let currentDay = '';
    const html = items.map(message => {
      const day = formatDay(message.updated_at);
      const separator = day && day !== currentDay ? `<div class="day-label">${escapeHtml(day)}</div>` : '';
      currentDay = day;
      return `${separator}
      <div class="message-row ${message.outgoing ? 'outgoing' : 'incoming'}" data-message="${message.id}">
        <article class="bubble${message.deleted ? ' deleted' : ''}">
          ${!message.outgoing ? `<div class="author">${escapeHtml(message.author)}</div>` : ''}
          ${message.reply ? `<div class="reply"><b>${escapeHtml(message.reply.author)}</b><span>${escapeHtml(message.reply.text || 'Сообщение')}</span></div>` : ''}
          ${mediaMarkup(message.media)}
          ${message.text ? `<div class="message-text">${escapeHtml(message.text)}</div>` : ''}
          ${message.deleted ? '<div class="message-text deleted-label">Сообщение удалено</div>' : ''}
          <div class="message-meta">${message.editable ? `<button class="message-edit" type="button" data-edit-message="${message.id}" aria-label="Редактировать сообщение"><svg viewBox="0 0 24 24"><path d="m4 20 4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10L4 20Z"/><path d="m14 7 3 3"/></svg></button>` : ''}${message.edited ? `<span>изменено${message.edit_count > 1 ? ' ' + message.edit_count + '×' : ''}</span>` : ''}<time>${formatTime(message.updated_at)}</time>${message.outgoing ? '<span class="checks">✓✓</span>' : ''}</div>
        </article>
      </div>`;
    }).join('');
    if (prepend) {
      const oldHeight = scroll.scrollHeight; const holder = document.createElement('div'); holder.innerHTML = html;
      const load = scroll.querySelector('.load-more'); Array.from(holder.children).reverse().forEach(node => load?.after(node));
      scroll.scrollTop += scroll.scrollHeight - oldHeight;
    } else { scroll.className = 'message-scroll'; scroll.innerHTML = `${state.nextBefore ? '<button class="load-more" type="button">Показать более ранние</button>' : ''}${html}`; scroll.scrollTop = scroll.scrollHeight; }
    scroll.querySelector('.load-more')?.addEventListener('click', () => loadMessages(true));
    scroll.querySelectorAll('.spoiler').forEach(el => el.addEventListener('click', () => el.classList.add('revealed')));
    initLottie(scroll);
  }

  function initLottie(root) {
    if (!window.lottie) { setTimeout(() => initLottie(root), 250); return; }
    root.querySelectorAll('[data-lottie]:not([data-ready])').forEach(async el => {
      el.dataset.ready = '1';
      try {
        const response = await fetch(el.dataset.lottie, { headers: { 'X-Telegram-Init-Data': initData, ...(devUser ? {'X-Holygram-Dev-User':devUser} : {}) } });
        if (!response.ok) throw new Error();
        const animationData = await response.json();
        window.lottie.loadAnimation({container: el, renderer:'svg', loop:true, autoplay:true, animationData});
      } catch (_) { el.textContent = 'Стикер'; }
    });
  }

  async function loadMessages(older, beforeOverride = 0, focusMessageId = 0) {
    if (!state.user || !state.chat || (older && (!state.nextBefore || state.loadingMore))) return;
    const scroll = $('messageScroll');
    if (!older) { scroll.className = 'message-scroll'; scroll.innerHTML = skeleton(4); }
    state.loadingMore = true;
    try {
      const before = older ? `&before=${state.nextBefore}` : (beforeOverride ? `&before=${beforeOverride}` : '');
      const data = await api(`/api/users/${state.user.id}/chats/${state.chat.id}/messages?limit=60${before}`);
      state.nextBefore = data.next_before;
      if (!older && !data.items.length) { scroll.className = 'message-scroll empty-state'; scroll.innerHTML = empty('…', 'Сообщений нет', 'В этом чате пока ничего не сохранено'); return; }
      renderMessages(data.items, older);
      state.chat.unread = 0;
      if (!older && focusMessageId) {
        requestAnimationFrame(() => {
          const row = $('messageScroll').querySelector(`[data-message="${focusMessageId}"]`);
          if (row) {
            row.classList.add('search-focus');
            row.scrollIntoView({block: 'center', behavior: 'smooth'});
            setTimeout(() => row.classList.remove('search-focus'), 2600);
          } else {
            toast('Чат открыт, но сообщение глубже в истории');
          }
        });
      }
    } catch (error) { if (!older) { scroll.className = 'message-scroll empty-state'; scroll.innerHTML = empty('!', 'Не удалось открыть сообщения', error.message); } else toast(error.message); }
    finally { state.loadingMore = false; }
  }

  function showFatal(message) {
    $('authErrorText').textContent = message;
    $('authError').classList.remove('hidden');
    app.classList.add('hidden');
  }

  $('userSearch').addEventListener('input', debounce(event => loadUsers(event.target.value)));
  $('chatSearch').addEventListener('input', debounce(event => { const query = event.target.value.trim(); if (query) searchAllMessages(query); else { state.globalSearchQuery = ''; state.searchResults = []; state.searchOffset = 0; state.searchHasMore = false; loadChats(); } }));
  $('accountButton').addEventListener('click', () => toggleAccounts(true));
  $('closeAccounts').addEventListener('click', () => toggleAccounts(false));
  $('accountScrim').addEventListener('click', () => toggleAccounts(false));
  $('refreshChatsButton').addEventListener('click', () => { const query = $('chatSearch').value.trim(); if (query) searchAllMessages(query); else if (state.user) loadChats(); });
  $('conversationSearch').addEventListener('click', () => { $('messageSearchBar').classList.toggle('hidden'); if (!$('messageSearchBar').classList.contains('hidden')) $('messageSearch').focus(); });
  $('closeMessageSearch').addEventListener('click', () => { $('messageSearchBar').classList.add('hidden'); $('messageSearch').value = ''; document.querySelectorAll('.message-row').forEach(row => row.classList.remove('hidden')); });
  $('messageSearch').addEventListener('input', event => { const q = event.target.value.trim().toLocaleLowerCase('ru'); document.querySelectorAll('.message-row').forEach(row => row.classList.toggle('hidden', Boolean(q) && !row.textContent.toLocaleLowerCase('ru').includes(q))); });
  document.querySelectorAll('[data-filter]').forEach(button => button.addEventListener('click', () => { state.filter = button.dataset.filter; document.querySelectorAll('[data-filter]').forEach(item => item.classList.toggle('active', item === button)); renderChats($('chatSearch').value); }));
  $('refreshButton').addEventListener('click', () => { loadMessages(false); loadChats($('chatSearch').value); toast('Чат синхронизирован'); });
  $('cancelEdit').addEventListener('click', closeMessageEditor);
  $('editScrim').addEventListener('click', closeMessageEditor);
  $('saveEdit').addEventListener('click', saveMessageEdit);
  document.querySelectorAll('[data-back]').forEach(button => button.addEventListener('click', () => { app.dataset.view = button.dataset.back; }));
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && !$('editSheet').classList.contains('hidden')) closeMessageEditor(); });
  document.addEventListener('click', event => {
    const edit = event.target.closest('[data-edit-message]');
    if (edit) { event.preventDefault(); event.stopPropagation(); openMessageEditor(Number(edit.dataset.editMessage)); return; }
    const sendBot = event.target.closest('[data-send-bot]');
    if (sendBot) { event.preventDefault(); event.stopPropagation(); sendMediaToBot(sendBot); return; }
    const download = event.target.closest('[data-download]');
    if (download) { event.preventDefault(); event.stopPropagation(); downloadMedia(download); return; }
    if (event.target.closest('.spoiler')) event.target.closest('.spoiler').classList.add('revealed');
  });
  document.addEventListener('error', event => { if (event.target instanceof HTMLImageElement && event.target.closest('.avatar')) event.target.remove(); }, true);

  (async () => {
    try {
      const bootstrap = await api('/api/bootstrap');
      $('ownerAvatar').textContent = initials(bootstrap.owner.name);
      await loadUsers();
      const targetUser = Number(qs.get('target'));
      if (targetUser && state.users.some(user => user.id === targetUser)) {
        await selectUser(targetUser);
        const targetChat = Number(qs.get('chat'));
        if (targetChat && state.chats.some(chat => chat.id === targetChat)) await selectChat(targetChat);
      } else if (state.users.length) await selectUser(state.users[0].id);
    } catch (error) { showFatal(error.message); }
  })();
})();