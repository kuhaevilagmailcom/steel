# Скопируй в .env.deleted_logger и заполни своими значениями.
# Токен от @BotFather
# Bothost also supplies BOT_TOKEN automatically; locally use LOGGER_BOT_TOKEN.
LOGGER_BOT_TOKEN=1234567890:your_bot_token
# Username бота без @
LOGGER_BOT_USERNAME=your_bot_username_without_at
# Telegram ID админов через запятую (управление ботом в ЛС)
ADMIN_USER_IDS=
# RollyPay для оплаты по СБП (оставьте API_KEY пустым, чтобы отключить СБП)
ROLLYPAY_API_BASE=https://api.rollypay.io
ROLLYPAY_TERMINAL_ID=
ROLLYPAY_API_KEY=
ROLLYPAY_TEST_MODE=false
# Лимит локального архива медиа в мегабайтах.
# Официальный Telegram Bot API через getFile скачивает максимум 20 МБ.
MAX_MEDIA_ARCHIVE_MB=20
# 1 — пересылать медиа из бизнес-таймеров, 0 — нет
FORWARD_TIMER_MEDIA=1
# 1 — пересылать все бизнес-медиа, 0 — только удалённые
FORWARD_ALL_BUSINESS_MEDIA=0
# Рефералка: за сколько приглашённых (REF_REQUIRED) дать дней триала (REF_DAYS)
REF_REQUIRED=3
REF_DAYS=3
# Persistent data directory. Docker/BotHost sets this to /app/data.
# DATA_DIR=/app/data

# Необязательно: Telegram ID твоих тестовых аккаунтов через запятую.
# Нужны только если какой-то тестовый аккаунт ещё не был подключён на момент первого запуска этой версии.
TEST_ACCOUNT_IDS=
