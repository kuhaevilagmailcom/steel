# Скопируй в .env.deleted_logger и заполни своими значениями.
# Токен от @BotFather
LOGGER_BOT_TOKEN=1234567890:your_bot_token
# Username бота без @
LOGGER_BOT_USERNAME=your_bot_username_without_at
# Telegram ID админов через запятую (управление ботом в ЛС)
ADMIN_USER_IDS=
# Лимит архива медиа в мегабайтах
MAX_MEDIA_ARCHIVE_MB=50
# 1 — пересылать медиа из бизнес-таймеров, 0 — нет
FORWARD_TIMER_MEDIA=1
# 1 — пересылать все бизнес-медиа, 0 — только удалённые
FORWARD_ALL_BUSINESS_MEDIA=0
